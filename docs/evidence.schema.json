{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "synthetic": {
      "type": "boolean",
      "description": "True only for test fixtures. Production data must be false."
    },
    "binding": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "normalization": {
          "type": "string",
          "const": "collapse-unicode-whitespace-v2"
        },
        "scope": {
          "type": "string",
          "const": "reviewed_text_only"
        }
      },
      "required": [
        "algorithm",
        "normalization",
        "scope"
      ],
      "additionalProperties": false,
      "description": "How fingerprints are made: over the reviewed quote or row only, never a whole page."
    },
    "approved_hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "runtime_api",
              "official",
              "guide"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "host",
          "role",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "game": {
            "type": "string",
            "const": "Grand Theft Auto VI"
          },
          "cheat_name": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Up",
                "Down",
                "Left",
                "Right"
              ]
            }
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "ps5",
              "xbox-series"
            ]
          },
          "input_method": {
            "type": "string",
            "enum": [
              "d-pad",
              "phone",
              "unknown"
            ]
          },
          "entry_steps": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "game_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "evidence_type": {
                  "type": "string",
                  "enum": [
                    "official_documentation",
                    "guide_own_test",
                    "independent_report",
                    "gameplay_video"
                  ]
                },
                "own_test_covers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "input",
                      "effect",
                      "platform",
                      "unlock_timing",
                      "entry_method"
                    ]
                  }
                },
                "origin": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Who originally produced this information."
                },
                "independence": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Why this is independent of the other evidence, or why that does not apply."
                },
                "fingerprint": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^sha256:.*",
                  "description": "Fingerprint of the reviewed quote."
                },
                "captured_at": {
                  "type": "string",
                  "minLength": 1
                },
                "runtime_recheck": {
                  "type": "string",
                  "enum": [
                    "permitted",
                    "not_permitted",
                    "review_only"
                  ],
                  "description": "permitted: the host allows automated retrieval of this URL. not_permitted: offline-reviewed only. review_only: gameplay video."
                },
                "permission_basis": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The robots rule or terms clause the re-check decision rests on."
                },
                "video": {
                  "type": "object",
                  "properties": {
                    "account": {
                      "type": "string",
                      "minLength": 1
                    },
                    "posted_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "review_basis": {
                      "type": "string",
                      "enum": [
                        "frames",
                        "transcript",
                        "title",
                        "thumbnail",
                        "description",
                        "caption"
                      ]
                    },
                    "inspection_method": {
                      "type": "string",
                      "minLength": 1,
                      "description": "How the frames were inspected."
                    },
                    "console_identified": {
                      "type": "string",
                      "minLength": 1,
                      "description": "What on screen identifies the platform."
                    },
                    "continuous_footage": {
                      "type": "boolean"
                    },
                    "entry_timestamp": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entry_visible": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect_timestamp": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect_visible": {
                      "type": "string",
                      "minLength": 1
                    },
                    "presses_visible": {
                      "type": "string",
                      "enum": [
                        "button_presses",
                        "on_screen_sequence_only"
                      ]
                    }
                  },
                  "required": [
                    "account",
                    "posted_at",
                    "review_basis",
                    "inspection_method",
                    "console_identified",
                    "continuous_footage",
                    "entry_timestamp",
                    "entry_visible",
                    "effect_timestamp",
                    "effect_visible",
                    "presses_visible"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "url",
                "quote",
                "evidence_type",
                "own_test_covers",
                "origin",
                "independence",
                "fingerprint",
                "captured_at",
                "runtime_recheck",
                "permission_basis"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ai_agent",
                      "human"
                    ]
                  }
                },
                "required": [
                  "identity",
                  "type"
                ],
                "additionalProperties": false
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reviewed_at",
              "decision",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "claim_id",
          "game",
          "cheat_name",
          "input",
          "effect",
          "platform",
          "input_method",
          "entry_steps",
          "game_version",
          "evidence",
          "review"
        ],
        "additionalProperties": false
      }
    },
    "conflict_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict_group_id": {
            "type": "string",
            "minLength": 1
          },
          "cheat_name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "min_level": {
            "description": "Spoiler level a reviewer cleared this group for when it is returned from the manifest alone. Absent means full only.",
            "type": "string",
            "enum": [
              "hints",
              "discovery",
              "full"
            ]
          },
          "level_review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ai_agent",
                      "human"
                    ]
                  }
                },
                "required": [
                  "identity",
                  "type"
                ],
                "additionalProperties": false
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reviewed_at",
              "reason"
            ],
            "additionalProperties": false
          },
          "variants": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "Up",
                      "Down",
                      "Left",
                      "Right"
                    ]
                  }
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "ps5",
                    "xbox-series",
                    "unattributed"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "archive_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      },
                      "captured_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lineage": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "url",
                      "archive_url",
                      "quote",
                      "captured_at",
                      "lineage"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "claim_id",
                "input",
                "platform",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ai_agent",
                      "human"
                    ]
                  }
                },
                "required": [
                  "identity",
                  "type"
                ],
                "additionalProperties": false
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reviewed_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "conflict_group_id",
          "cheat_name",
          "summary",
          "variants",
          "review"
        ],
        "additionalProperties": false
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict_group_id": {
            "type": "string",
            "minLength": 1
          },
          "winning_claim_id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "official_documentation",
              "independent_direct_verifications"
            ]
          },
          "supporting": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "string",
                  "minLength": 1
                },
                "verified_directly": {
                  "type": "boolean"
                },
                "video": {
                  "description": "Required when the supporting item is a gameplay video; such a video counts as a direct verification.",
                  "type": "object",
                  "properties": {
                    "account": {
                      "type": "string",
                      "minLength": 1
                    },
                    "posted_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "review_basis": {
                      "type": "string",
                      "enum": [
                        "frames",
                        "transcript",
                        "title",
                        "thumbnail",
                        "description",
                        "caption"
                      ]
                    },
                    "inspection_method": {
                      "type": "string",
                      "minLength": 1,
                      "description": "How the frames were inspected."
                    },
                    "console_identified": {
                      "type": "string",
                      "minLength": 1,
                      "description": "What on screen identifies the platform."
                    },
                    "continuous_footage": {
                      "type": "boolean"
                    },
                    "entry_timestamp": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entry_visible": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect_timestamp": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect_visible": {
                      "type": "string",
                      "minLength": 1
                    },
                    "presses_visible": {
                      "type": "string",
                      "enum": [
                        "button_presses",
                        "on_screen_sequence_only"
                      ]
                    }
                  },
                  "required": [
                    "account",
                    "posted_at",
                    "review_basis",
                    "inspection_method",
                    "console_identified",
                    "continuous_footage",
                    "entry_timestamp",
                    "entry_visible",
                    "effect_timestamp",
                    "effect_visible",
                    "presses_visible"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "url",
                "quote",
                "origin",
                "verified_directly"
              ],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "dispositions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "upheld",
                    "rejected"
                  ]
                }
              },
              "required": [
                "claim_id",
                "disposition"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ai_agent",
                      "human"
                    ]
                  }
                },
                "required": [
                  "identity",
                  "type"
                ],
                "additionalProperties": false
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reviewed_at",
              "decision",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "conflict_group_id",
          "winning_claim_id",
          "basis",
          "supporting",
          "rationale",
          "dispositions",
          "review"
        ],
        "additionalProperties": false
      }
    },
    "community_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "social_platform": {
            "type": "string",
            "enum": [
              "reddit",
              "x",
              "youtube",
              "tiktok",
              "forum"
            ]
          },
          "url": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^https:\\/\\/.*"
          },
          "author_handle": {
            "type": "string",
            "minLength": 1
          },
          "posted_at": {
            "type": "string",
            "minLength": 1
          },
          "captured_at": {
            "type": "string",
            "minLength": 1
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "text_claim",
              "screenshot",
              "gameplay_video"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "One neutral line written by the reviewer."
          },
          "min_level": {
            "type": "string",
            "enum": [
              "hints",
              "discovery",
              "full"
            ]
          },
          "subject": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "cheat"
                  },
                  "cheat_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "anyOf": [
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "Up",
                            "Down",
                            "Left",
                            "Right"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "ps5",
                      "xbox-series",
                      "unattributed"
                    ]
                  },
                  "effect": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "cheat_name",
                  "input",
                  "platform",
                  "effect"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "easter_egg"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_status": {
                    "type": "string",
                    "enum": [
                      "unverified",
                      "theory"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "title",
                  "evidence_status"
                ],
                "additionalProperties": false
              }
            ]
          },
          "video_review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "account": {
                    "type": "string",
                    "minLength": 1
                  },
                  "posted_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_basis": {
                    "type": "string",
                    "enum": [
                      "frames",
                      "transcript",
                      "title",
                      "thumbnail",
                      "description",
                      "caption"
                    ]
                  },
                  "inspection_method": {
                    "type": "string",
                    "minLength": 1,
                    "description": "How the frames were inspected."
                  },
                  "console_identified": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What on screen identifies the platform."
                  },
                  "continuous_footage": {
                    "type": "boolean"
                  },
                  "entry_timestamp": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entry_visible": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effect_timestamp": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effect_visible": {
                    "type": "string",
                    "minLength": 1
                  },
                  "presses_visible": {
                    "type": "string",
                    "enum": [
                      "button_presses",
                      "on_screen_sequence_only"
                    ]
                  }
                },
                "required": [
                  "account",
                  "posted_at",
                  "review_basis",
                  "inspection_method",
                  "console_identified",
                  "continuous_footage",
                  "entry_timestamp",
                  "entry_visible",
                  "effect_timestamp",
                  "effect_visible",
                  "presses_visible"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ai_agent",
                      "human"
                    ]
                  }
                },
                "required": [
                  "identity",
                  "type"
                ],
                "additionalProperties": false
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reviewed_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "social_platform",
          "url",
          "author_handle",
          "posted_at",
          "captured_at",
          "evidence_type",
          "description",
          "min_level",
          "subject",
          "video_review",
          "review"
        ],
        "additionalProperties": false
      },
      "description": "Reviewed community leads. Never approval evidence on their own."
    },
    "spoiler_registry": {
      "type": "object",
      "properties": {
        "review": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "object",
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ai_agent",
                    "human"
                  ]
                }
              },
              "required": [
                "identity",
                "type"
              ],
              "additionalProperties": false
            },
            "reviewed_at": {
              "type": "string",
              "minLength": 1
            },
            "scope_note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reviewer",
            "reviewed_at",
            "scope_note"
          ],
          "additionalProperties": false
        },
        "titles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "fandom",
                  "wikipedia"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "min_level": {
                "type": "string",
                "enum": [
                  "hints",
                  "discovery",
                  "full"
                ]
              }
            },
            "required": [
              "provider",
              "title",
              "min_level"
            ],
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "fandom",
                  "wikipedia"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string"
              },
              "min_level": {
                "type": "string",
                "enum": [
